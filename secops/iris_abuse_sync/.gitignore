# Environment variables & secrets
.env
.env.local
.env.*.local
*.key
*.pem
*.secret

# Databases & local storage
storage/*.db
storage/*.db-shm
storage/*.db-wal
storage/backups/*
!storage/backups/.gitkeep
storage/migration_backups/*
!storage/migration_backups/.gitkeep
storage/evidences/*
!storage/evidences/.gitkeep
storage/reports/*
!storage/reports/.gitkeep
storage/retention_config.json
*.tar.gz

# Frontend dependencies and builds
frontend/node_modules/
frontend/dist/
frontend/.eslintcache

# Virtual environments
venv/
env/
.venv/

# Python cache & tests
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Runtime & Scratch
scratch/*
!scratch/.gitkeep
inbox/*
!inbox/.gitkeep
processed/*
!processed/.gitkeep
errors/*
!errors/.gitkeep

# Service PID and logs
.service.pid
*.log
web.log

# OS metadata
.DS_Store
Thumbs.db
