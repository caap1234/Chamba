# ==========================================================
# Configuración de Integración con DFIR-IRIS — SOC Neubox
# ==========================================================

# URL de tu instancia de DFIR-IRIS (Local o VPS)
IRIS_URL=https://iris.example.com

# API Key generada en DFIR-IRIS (My Settings -> API Key)
IRIS_API_KEY=tu_api_key_de_dfir_iris_aqui

# ID del Cliente / Organización por defecto en DFIR-IRIS (ej. 2 para Neubox, 3 para Hospedando)
IRIS_CUSTOMER_ID=2

# Verificación de certificados SSL (true / false)
# Usar 'false' si DFIR-IRIS utiliza certificados autofirmados o IP directa
IRIS_VERIFY_SSL=false

# Puerto y Host para el servidor Web UI
WEB_HOST=127.0.0.1
WEB_PORT=8080

# (Opcional) Motor LLM Híbrido para refinamiento semántico
# Opciones disponibles: 'none' (100% regex/heurística, sin costo), 'gemini', 'openai', 'ollama'
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=llama3:latest
OLLAMA_URL=http://127.0.0.1:11434
