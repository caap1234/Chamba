# ==========================================================
# Configuración DFIR-IRIS Abuse Sync SOC Platform v3.1
# ==========================================================

# Seguridad & Sesión
APP_SECRET_KEY=genera_un_secreto_hex_aleatorio_aqui
ENCRYPTION_SECRET_KEY=genera_una_llave_fernet_base64_aqui
PORT=8080
HOST=0.0.0.0
DEBUG=False

# Administrador Inicial (Solo tomado en el primer bootstrap)
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=contrasena_inicial_segura_aqui
BOOTSTRAP_ADMIN_EMAIL=admin@soc.local
BOOTSTRAP_ADMIN_NAME=Administrador SOC

# URL y API Key de tu instancia oficial de DFIR-IRIS v2.4.29+
IRIS_URL=https://iris.ejemplo.com
IRIS_API_KEY=tu_api_key_de_dfir_iris_aqui
IRIS_VERIFY_SSL=True

# Asistencia IA (Google Gemini API — Opcional)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# Base de datos y Almacenamiento local
DATABASE_URL=sqlite:///storage/soc_platform.db

